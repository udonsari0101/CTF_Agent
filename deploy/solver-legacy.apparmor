# Compatibility form of solver.apparmor for pre-ABI-4 parsers. It pins the
# AppArmor 3 policy ABI so network rules target upstream v8 socket mediation.
# It otherwise keeps the same three domains without includes or user namespaces.
abi <abi/3.0>,

profile "ctf-agent-solver" flags=(attach_disconnected,mediate_deleted) {
  file,
  # Synology's older AppArmor kernel does not reliably expand the coarse
  # `network,` grant. Spell out the Internet and local control transports.
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,
  network unix stream,
  network unix seqpacket,
  capability,
  deny capability sys_admin,
  deny mount,
  deny umount,
  deny pivot_root,

  /usr/local/libexec/ctf-agent-codex-launcher px -> "ctf-agent-solver//&ctf-agent-app-server",
  /usr/local/libexec/ctf-agent-claude-launcher px -> "ctf-agent-solver//&ctf-agent-app-server",
  /usr/local/libexec/ctf-agent-archive-launcher px -> "ctf-agent-solver//&ctf-agent-command",
  /usr/local/libexec/ctf-command/* ix,
  /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex ix,
  /usr/local/lib/node_modules/@openai/codex-linux-*/vendor/*/bin/codex ix,
  /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host ix,
  /usr/local/lib/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host ix,
  /usr/local/lib/node_modules/@anthropic-ai/claude-code/** ix,
  /usr/local/lib/node_modules/@anthropic-ai/claude-code-*/** ix,
  /solver-exchange/runtime/claude-*/node_modules/@anthropic-ai/claude-code-linux-*/claude ix,
  /solver-exchange/runtime/codex-*/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex ix,
  /solver-exchange/runtime/codex-*/node_modules/@openai/codex-linux-*/vendor/*/bin/codex ix,
  /solver-exchange/runtime/codex-*/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host ix,
  /solver-exchange/runtime/codex-*/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host ix,
  /bin/** ix,
  /usr/bin/** ix,
  /usr/local/bin/** ix,
  /solver-scratch/** ix,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer="ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-app-server",
  # Keep directed profile transitions a strict subset of the profile recorded
  # when Docker set no_new_privs.  The command-only ptrace grant supports gdb;
  # both child domains still deny access to the trusted worker and app-server.
  signal (send,receive) peer="ctf-agent-command",
  signal (send,receive) peer="ctf-agent-solver//&ctf-agent-command",
  signal (send,receive) peer="ctf-agent-command//&ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-solver//&ctf-agent-app-server",
  signal (send,receive) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  signal (send,receive) peer="ctf-agent-app-server//&ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  ptrace (trace,read) peer="ctf-agent-command",
  ptrace (trace,read) peer="ctf-agent-solver//&ctf-agent-app-server",
  ptrace (trace,read) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  ptrace (trace,read) peer="ctf-agent-app-server//&ctf-agent-solver",
  ptrace (trace,read) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  ptrace (trace,read) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  ptrace (readby,tracedby) peer="ctf-agent-solver",
  ptrace (readby,tracedby) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  ptrace (readby,tracedby) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  ptrace (readby,tracedby) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  # The credential-holding provider may inspect its restricted child while
  # collecting tool exit status. The reverse read remains denied.
  ptrace (readby) peer="ctf-agent-app-server//&ctf-agent-solver",

  deny /proc/* w,
  deny /proc/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny /proc/sys/[^k]** w,
  deny /proc/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /proc/[0-9]*/mem r,
  deny /proc/[0-9]*/environ r,
  deny /proc/[0-9]*/fd/ r,
  deny /proc/[0-9]*/fd/** r,
  deny /dev/shm/** wklx,
  deny /run/shm/** wklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  deny ptrace (trace,read) peer="ctf-agent-solver",
}

profile "ctf-agent-app-server" flags=(attach_disconnected,mediate_deleted) {
  /** rm,
  /solver-scratch/** rwklmix,
  /dev/null rw,
  /dev/tty rw,
  /dev/urandom r,
  /dev/random r,

  /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex ix,
  /usr/local/lib/node_modules/@openai/codex-linux-*/vendor/*/bin/codex ix,
  # Code-mode-only models delegate their functions.exec tool to this sibling
  # host. It stays in the provider domain and its shell children transition
  # into the filesystem-isolated command profile.
  /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host ix,
  /usr/local/lib/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host ix,
  /usr/local/lib/node_modules/@anthropic-ai/claude-code/** ix,
  /usr/local/lib/node_modules/@anthropic-ai/claude-code-*/** ix,
  /solver-exchange/runtime/claude-*/node_modules/@anthropic-ai/claude-code-linux-*/claude ix,
  /solver-exchange/runtime/codex-*/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex ix,
  /solver-exchange/runtime/codex-*/node_modules/@openai/codex-linux-*/vendor/*/bin/codex ix,
  /solver-exchange/runtime/codex-*/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host ix,
  /solver-exchange/runtime/codex-*/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host ix,
  /usr/local/libexec/ctf-command/* px -> "ctf-agent-app-server//&ctf-agent-command",
  # Codex can use its Linux fallback or a model-selected shell. Match the
  # merged-/usr aliases and sh's dash target in the compatibility profile too.
  /bin/bash px -> "ctf-agent-app-server//&ctf-agent-command",
  /bin/dash px -> "ctf-agent-app-server//&ctf-agent-command",
  /bin/sh px -> "ctf-agent-app-server//&ctf-agent-command",
  /usr/bin/bash px -> "ctf-agent-app-server//&ctf-agent-command",
  /usr/bin/dash px -> "ctf-agent-app-server//&ctf-agent-command",
  /usr/bin/sh px -> "ctf-agent-app-server//&ctf-agent-command",
  /usr/lib/git-core/git px -> "ctf-agent-app-server//&ctf-agent-command",
  # Git already runs with ctf-agent-command stacked. Its protocol helper must
  # inherit that label instead of attempting the same px transition twice.
  /usr/lib/git-core/git-remote-* ix,
  # ctf-browser has already crossed into the stacked command domain. The real
  # Chromium executable and its helpers inherit that same restricted label.
  /usr/lib/chromium/** ix,
  /bin/** ix,
  /usr/bin/** ix,
  /usr/local/bin/** ix,

  # The provider app-server and challenge commands both need HTTPS/DNS.
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,
  network unix stream,
  network unix seqpacket,
  /solver-exchange/runtime/** rm,
  deny /solver-exchange/ r,
  deny /solver-exchange/active{,/**} rwklmx,
  deny /solver-exchange/worker.json rwklmx,
  deny /solver-exchange/worker.lock rwklmx,
  deny /solver-input/ r,
  deny /solver-input/*/ r,
  deny /solver-input/runtime{,/**} rm,
  deny /solver-input/.staging-*{,/**} rm,
  deny /solver-input/.retired-*{,/**} rm,
  deny /solver-input/worker.json rm,
  deny /solver-input/worker.lock rm,
  deny /solver-input/*/{auth.json,.credentials.json,.api-key,.auth-*.tmp,manifest.json,state.json,cancel,credential-request.json,control.json} rm,
  deny /solver-input/*/events{,/**} rm,
  deny /solver-input{,/**} wklx,

  signal (receive) peer="ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-app-server",
  signal (send,receive) peer="ctf-agent-command",
  signal (send,receive) peer="ctf-agent-solver//&ctf-agent-app-server",
  signal (send,receive) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  signal (send,receive) peer="ctf-agent-app-server//&ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  ptrace (trace,read) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  ptrace (trace,read) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  ptrace (trace,read) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  ptrace (readby,tracedby) peer="ctf-agent-solver",
  ptrace (readby,tracedby) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  ptrace (readby,tracedby) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  ptrace (readby,tracedby) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  ptrace (readby) peer="ctf-agent-app-server//&ctf-agent-solver",

  deny mount,
  deny umount,
  deny pivot_root,
  deny /proc/[0-9]*/mem r,
  deny /proc/[0-9]*/environ r,
  deny /proc/[0-9]*/fd/ r,
  deny /proc/[0-9]*/fd/** r,
  deny /sys/** wklx,
  deny /proc/sys/** wklx,
  deny /dev/shm/** wklx,
  deny /run/shm/** wklx,
  deny ptrace (trace,read) peer="ctf-agent-solver",
}

profile "ctf-agent-command" flags=(attach_disconnected,mediate_deleted) {
  /** rmix,
  /solver-scratch/** rwklmix,
  /dev/null rw,
  /dev/tty rw,
  /dev/urandom r,
  /dev/random r,

  deny /solver-exchange{,/**} rwklmx,
  deny /solver-input/ r,
  deny /solver-input/*/ r,
  deny /solver-input/runtime{,/**} rm,
  deny /solver-input/.staging-*{,/**} rm,
  deny /solver-input/.retired-*{,/**} rm,
  deny /solver-input/worker.json rm,
  deny /solver-input/worker.lock rm,
  deny /solver-input/*/{auth.json,.credentials.json,.api-key,.auth-*.tmp,manifest.json,state.json,cancel,credential-request.json,control.json} rm,
  deny /solver-input/*/events{,/**} rm,
  deny /solver-input{,/**} wklx,
  deny /solver-scratch/ctf-job-*/home{,/**} rwklmx,
  deny /solver-scratch/ctf-attest-*/home{,/**} rwklmx,
  deny /solver-scratch/ctf-attest-*/claude-home rwklmx,
  deny /solver-scratch/ctf-attest-*/claude-home/ rwklmx,
  deny /solver-scratch/ctf-attest-*/claude-home/** rwklmx,
  deny /solver-scratch/**/competition/skills/** wklx,
  # Match direct challenge inputs, but not descendants of codex-workdir.
  deny /solver-scratch/**/competition/challenge/* wklx,
  deny /solver-scratch/**/competition/challenge/chal_desc.md wklx,
  deny /solver-scratch/**/competition/challenge/codex-workdir/AGENTS.md wklx,
  deny /solver-scratch/**/competition/challenge/codex-workdir/CLAUDE.md wklx,

  deny /usr/local/libexec/ctf-agent-codex-launcher x,
  deny /usr/local/libexec/ctf-agent-claude-launcher x,
  deny /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex x,
  deny /usr/local/lib/node_modules/@openai/codex-linux-*/vendor/*/bin/codex x,
  deny /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host x,
  deny /usr/local/lib/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host x,
  deny /usr/local/lib/node_modules/@anthropic-ai/claude-code/** x,
  deny /usr/local/lib/node_modules/@anthropic-ai/claude-code-*/** x,
  deny /solver-exchange/runtime/claude-*/node_modules/@anthropic-ai/claude-code-linux-*/claude x,
  deny /solver-exchange/runtime/codex-*/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex x,
  deny /solver-exchange/runtime/codex-*/node_modules/@openai/codex-linux-*/vendor/*/bin/codex x,
  deny /solver-exchange/runtime/codex-*/node_modules/@openai/codex/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host x,
  deny /solver-exchange/runtime/codex-*/node_modules/@openai/codex-linux-*/vendor/*/bin/codex-code-mode-host x,

  # Keep explicit Internet transports for older Synology AppArmor parsers.
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,
  network unix stream,
  network unix seqpacket,
  deny mount,
  deny umount,
  deny pivot_root,

  signal (receive) peer="ctf-agent-app-server",
  signal (receive) peer="ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-command",
  ptrace (trace,read) peer="ctf-agent-command",
  signal (receive) peer="ctf-agent-solver//&ctf-agent-app-server",
  signal (send,receive) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  signal (receive) peer="ctf-agent-app-server//&ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  signal (send,receive) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  ptrace (trace,read) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  ptrace (trace,read) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  ptrace (trace,read) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  ptrace (readby,tracedby) peer="ctf-agent-solver",
  ptrace (readby,tracedby) peer="ctf-agent-solver//&ctf-agent-app-server//&ctf-agent-command",
  ptrace (readby,tracedby) peer="ctf-agent-app-server//&ctf-agent-command//&ctf-agent-solver",
  ptrace (readby,tracedby) peer="ctf-agent-command//&ctf-agent-app-server//&ctf-agent-solver",
  ptrace (readby) peer="ctf-agent-app-server//&ctf-agent-solver",
  deny ptrace (trace,read) peer="ctf-agent-solver",
  deny ptrace (trace,read) peer="ctf-agent-app-server",
  deny ptrace (trace,read) peer="ctf-agent-solver//&ctf-agent-app-server",

  deny /proc/[0-9]*/mem r,
  deny /proc/[0-9]*/environ r,
  deny /proc/[0-9]*/fd/ r,
  deny /proc/[0-9]*/fd/** r,
  deny /proc/sys/** wklx,
  deny /sys/** wklx,
  deny /dev/shm/** wklx,
  deny /run/shm/** wklx,
}
